<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Study Hub</title>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="style.css">
</head>
<body>

<!-- LOGIN -->
<div id="loginBox" class="container d-flex justify-content-center align-items-center vh-100">
  <div class="card p-4 shadow login-card">
    <h3 class="text-center mb-3">📚 Study Hub</h3>
    <input class="form-control mb-3" id="username" placeholder="Enter username">
    <button class="btn btn-primary w-100" onclick="login()">Login</button>
  </div>
</div>

<!-- APP -->
<div id="app" class="d-none">

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-light px-4">
  <span class="navbar-brand fw-bold">Study Hub</span>
  <div class="ms-auto">
    <button class="btn btn-outline-secondary me-2" onclick="showSection('home')">Home</button>
    <button class="btn btn-outline-secondary me-2" onclick="showSection('profile')">Profile</button>
    <button class="btn btn-outline-dark me-2" onclick="toggleTheme()">🌙</button>
    <button class="btn btn-danger" onclick="logout()">Logout</button>
  </div>
</nav>

<!-- HOME -->
<section id="home" class="container py-4">
  <h3 class="text-center mb-3">Your Study Dashboard</h3>

  <div class="text-center">
    <img src="https://cdn-icons-png.flaticon.com/512/4345/4345573.png" class="hero mb-3">
  </div>

  <div class="row text-center mb-4">
    <div class="col-md-4">
      <div class="card pastel-card p-3" onclick="showSection('todo')">📝 To-Do</div>
    </div>
    <div class="col-md-4">
      <div class="card pastel-card p-3" onclick="showSection('timer')">⏱ Timer</div>
    </div>
    <div class="col-md-4">
      <div class="card pastel-card p-3" onclick="showSection('notes')">📒 Notes</div>
    </div>
  </div>

  <h5 class="text-center">📊 Your Progress</h5>
  <canvas id="progressChart" width="350" height="180" class="mx-auto d-block"></canvas>
</section>

<!-- PROFILE -->
<section id="profile" class="container py-4 d-none">
  <h4 class="text-center mb-3">My Profile</h4>

  <div class="card p-4 mx-auto profile-card">
    <input type="file" class="form-control mb-2" id="profileImg" accept="image/*">
    <label>Date of Birth</label>
    <input type="date" class="form-control mb-2" id="dob">
    <button class="btn btn-success w-100" onclick="saveProfile()">Save Profile</button>

    <div class="text-center mt-3">
      <img id="preview" class="profile-img mb-2">
      <p id="profileName"></p>
      <p id="profileDob"></p>
    </div>
  </div>
</section>

<!-- TODO -->
<section id="todo" class="container py-4 d-none">
  <h4 class="text-center mb-3">📝 To-Do Manager</h4>
  <div class="input-group mb-3">
    <input class="form-control" id="todoInput" placeholder="Enter task">
    <button class="btn btn-primary" onclick="addTodo()">Add</button>
  </div>
  <ul id="todoList" class="list-unstyled"></ul>
</section>

<!-- TIMER -->
<section id="timer" class="container py-4 d-none text-center">
  <h4>⏱ Study Timer</h4>
  <input type="number" class="form-control w-25 mx-auto mb-3" id="minutes" placeholder="Minutes">
  <button class="btn btn-success me-2" onclick="startTimer()">Start</button>
  <button class="btn btn-warning" onclick="stopTimer()">Stop</button>
  <h3 id="display" class="mt-3">00:00</h3>
</section>

<!-- NOTES -->
<section id="notes" class="container py-4 d-none">
  <h4 class="text-center mb-3">📒 Notes Manager</h4>
  <textarea id="noteText" class="form-control mb-2" placeholder="Write your notes here..."></textarea>
  <div class="text-center mb-3">
    <button class="btn btn-primary me-2" onclick="addNote()">Add</button>
    <button class="btn btn-secondary" onclick="downloadNote()">Save as DOC</button>
  </div>
  <div id="notesBox"></div>
</section>

</div>

<script src="script.js"></script>
</body>
</html>

